@page "/courses"
@using SmartTable.Client.Models
@inject ICourseService CourseSvc
@inject ICourseTermService CourseTermSvc
@inject IDialogService DialogSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc
@implements IDisposable

<PageTitle>@LocalizationSvc.GetString("Courses") — SmartTable</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">@LocalizationSvc.GetString("Courses")</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @LocalizationSvc.GetString("Total"): @_courses.Count
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog"
               Disabled="_loading">
        @LocalizationSvc.GetString("AddCourse")
    </MudButton>
</div>

<MudTextField @bind-Value="_searchTerm"
              Placeholder="@LocalizationSvc.GetString("SearchByTypeOrLanguage")"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined"
              Immediate="true"
              DebounceInterval="250"
              Class="mb-4"
              Style="max-width:400px;" />

<MudDataGrid T="Course"
             Items="FilteredCourses"
             SortMode="SortMode.Multiple"
             Hover="true"
             Striped="true"
             Dense="true"
             Loading="_loading">
    <Columns>
        <TemplateColumn Title="@LocalizationSvc.GetString("Course")">
            <CellTemplate>
                <strong>@context.Item.CourseType @context.Item.Language</strong>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CourseType" Title="@LocalizationSvc.GetString("CourseType")" />
        <PropertyColumn Property="x => x.Language" Title="@LocalizationSvc.GetString("Language_col")" />
        <TemplateColumn Title="@LocalizationSvc.GetString("FutureTermsCountCol")">
            <CellTemplate>@GetFutureTermsCount(context.Item.Id)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("NearestTermCol")">
            <CellTemplate>
                @{ var nearest = GetNearestTerm(context.Item.Id); }
                @(nearest is null ? "—" : nearest.StartDate.ToString("dd.MM.yyyy"))
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("ActionCol")" CellStyle="width:160px;">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo($"/courses/{context.Item.Id}/terms"))">
                        @LocalizationSvc.GetString("OpenAction")
                    </MudButton>
                    <MudTooltip Text="@LocalizationSvc.GetString("Edit")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditDialog(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="@LocalizationSvc.GetString("Delete")">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCourse(context.Item))" />
                    </MudTooltip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@LocalizationSvc.GetString("NoCoursesFound")</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Course> _courses = new();
    private List<CourseTerm> _allTerms = new();
    private string _searchTerm = string.Empty;
    private bool _loading = true;

    private IEnumerable<Course> FilteredCourses => _courses.Where(c =>
        string.IsNullOrWhiteSpace(_searchTerm) ||
        c.CourseType.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
        c.Language.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private int GetFutureTermsCount(Guid courseId) =>
        _allTerms.Count(t => t.CourseId == courseId && t.StartDate.Date >= DateTime.Today && t.Status != "cancelled");

    private CourseTerm? GetNearestTerm(Guid courseId) =>
        _allTerms.Where(t => t.CourseId == courseId && t.StartDate.Date >= DateTime.Today && t.Status != "cancelled")
                 .OrderBy(t => t.StartDate)
                 .FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        LocalizationSvc.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LocalizationSvc.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _courses = await CourseSvc.GetAllAsync();
            _allTerms = await CourseTermSvc.GetAllAsync();
        }
        catch { Snackbar.Add(LocalizationSvc.GetString("ErrorLoadingCourses"), Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenAddDialog() => await OpenCourseDialog(new Course(), isNew: true);
    private async Task OpenEditDialog(Course c) => await OpenCourseDialog(new Course { Id = c.Id, CourseType = c.CourseType, Language = c.Language }, isNew: false);

    private async Task OpenCourseDialog(Course model, bool isNew)
    {
        var parameters = new DialogParameters { ["Model"] = model, ["IsNew"] = isNew };
        var dialog = await DialogSvc.ShowAsync<CourseDialog>(
            isNew ? LocalizationSvc.GetString("NewCourse") : LocalizationSvc.GetString("EditCourse"),
            parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (!result.Canceled && result.Data is Course saved)
        {
            bool success = isNew ? (await CourseSvc.CreateAsync(saved)) is not null : await CourseSvc.UpdateAsync(saved);
            if (success)
            {
                Snackbar.Add(isNew ? LocalizationSvc.GetString("CourseAdded") : LocalizationSvc.GetString("CourseUpdated"), Severity.Success);
                await LoadDataAsync();
            }
            else Snackbar.Add(LocalizationSvc.GetString("SaveError"), Severity.Error);
        }
    }

    private async Task DeleteCourse(Course course)
    {
        var confirmed = await DialogSvc.ShowMessageBoxAsync(LocalizationSvc.GetString("Confirmation"),
            $"{LocalizationSvc.GetString("DeleteCourseQuestion")} «{course.CourseType} {course.Language}»?",
            yesText: LocalizationSvc.GetString("Yes"), cancelText: LocalizationSvc.GetString("Cancel"));

        if (confirmed == true)
        {
            var success = await CourseSvc.DeleteAsync(course.Id);
            if (success)
            {
                Snackbar.Add(LocalizationSvc.GetString("CourseDeleted"), Severity.Success);
                await LoadDataAsync();
            }
            else Snackbar.Add(LocalizationSvc.GetString("DeleteError"), Severity.Error);
        }
    }
}
