@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@using SmartTable.Client.Services
@inject IAdminUserService AdminSvc
@inject IDialogService DialogSvc
@inject ISnackbar Snackbar
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc
@implements IDisposable

<PageTitle>@LocalizationSvc.GetString("AdminManagementTitle") — SmartTable</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">@LocalizationSvc.GetString("AdminManagementTitle")</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @LocalizationSvc.GetString("TotalAdmins"): @_users.Count
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenCreateDialog"
               Disabled="_loading">
        @LocalizationSvc.GetString("AddAdmin")
    </MudButton>
</div>

<MudDataGrid T="AdminUserDto" Items="_users" Hover="true" Striped="true" Dense="true" Loading="_loading">
    <Columns>
        <PropertyColumn Property="x => x.Username" Title="@LocalizationSvc.GetString("LoginCol")" />
        <TemplateColumn Title="@LocalizationSvc.GetString("RoleCol")">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Role == "SuperAdmin" ? Color.Primary : Color.Default)">
                    @context.Item.Role
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CreatedAt" Title="@LocalizationSvc.GetString("CreatedAtCol")" Format="dd.MM.yyyy HH:mm" />
        <TemplateColumn Title="@LocalizationSvc.GetString("ActionCol")" CellStyle="width:80px;">
            <CellTemplate>
                @if (context.Item.Role != "SuperAdmin")
                {
                    <MudTooltip Text="@LocalizationSvc.GetString("DeleteAccountTooltip")">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteUser(context.Item))" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@LocalizationSvc.GetString("NoAccountsFound")</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<AdminUserDto> _users = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        LocalizationSvc.OnLanguageChanged += StateHasChanged;
        await LoadAsync();
    }

    public void Dispose() => LocalizationSvc.OnLanguageChanged -= StateHasChanged;

    private async Task LoadAsync()
    {
        _loading = true;
        try { _users = await AdminSvc.GetAllAsync(); }
        catch { Snackbar.Add(LocalizationSvc.GetString("LoadAdminsError"), Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await DialogSvc.ShowAsync<CreateAdminDialog>(LocalizationSvc.GetString("AddAdmin"), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not (string username, string password)) return;

        var (success, error) = await AdminSvc.CreateAsync(username, password);
        if (success)
        {
            Snackbar.Add(LocalizationSvc.GetString("AdminCreatedSuccess"), Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? LocalizationSvc.GetString("CreateAdminError"), Severity.Error);
        }
    }

    private async Task DeleteUser(AdminUserDto user)
    {
        var confirmed = await DialogSvc.ShowMessageBox(LocalizationSvc.GetString("Confirmation"),
            $"{LocalizationSvc.GetString("DeleteAdminConfirmMessage")} «{user.Username}»?", yesText: LocalizationSvc.GetString("Yes"), cancelText: LocalizationSvc.GetString("Cancel"));

        if (confirmed != true) return;

        var (success, error) = await AdminSvc.DeleteAsync(user.Id);
        if (success)
        {
            Snackbar.Add(LocalizationSvc.GetString("AdminDeletedSuccess"), Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? LocalizationSvc.GetString("DeleteAdminError"), Severity.Error);
        }
    }
}
