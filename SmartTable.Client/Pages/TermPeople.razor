@page "/courses/terms/{TermId:guid}/people"
@using SmartTable.Client.Models
@inject ICourseTermService CourseTermSvc
@inject IEnrollmentService EnrollSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc
@implements IDisposable

<PageTitle>@LocalizationSvc.GetString("EnrolledStudentsHeader") — SmartTable</PageTitle>

<MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick="GoBack" Class="mb-2">
    @LocalizationSvc.GetString("CourseDatesHeader")
</MudButton>

<MudText Typo="Typo.h5" Style="font-weight:700;" Class="mb-1">
    @(_term is null ? "…" : $"{_term.Course?.CourseType} {_term.Course?.Language} — {_term.StartDate:dd.MM.yyyy} – {_term.EndDate:dd.MM.yyyy}")
</MudText>
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
    @LocalizationSvc.GetString("EnrolledStudentsHeader"): @_enrollments.Count
</MudText>

@* ── Фільтри ──────────────────────────────────────────────────────────────── *@
<MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
    <MudText Typo="Typo.subtitle2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1 mb-1" />
        @LocalizationSvc.GetString("FiltersHeader")
    </MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_filterAttendance"
                       Label="@LocalizationSvc.GetString("AttendanceCol")" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("waiting_arrival")">Oczekuje na przyjazd</MudSelectItem>
                <MudSelectItem T="string" Value="@("arrived")">Dojechał</MudSelectItem>
                <MudSelectItem T="string" Value="@("no_show")">Nie dojechał</MudSelectItem>
                <MudSelectItem T="string" Value="@("late")">Spóźniony</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_filterPayment"
                       Label="@LocalizationSvc.GetString("PaymentStatusLabel")" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("unpaid")">Nie zapłacono</MudSelectItem>
                <MudSelectItem T="string" Value="@("partial")">Częściowo zapłacono</MudSelectItem>
                <MudSelectItem T="string" Value="@("paid")">Zapłacono</MudSelectItem>
                <MudSelectItem T="string" Value="@("overpaid")">Nadpłata</MudSelectItem>
                <MudSelectItem T="string" Value="@("not_required")">Niewymagane</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField T="string" @bind-Value="_filterCompany" Label="@LocalizationSvc.GetString("CompanyCol")"
                          Variant="Variant.Outlined" Dense="true" Immediate="true" DebounceInterval="200"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>
    @if (HasActiveFilters)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" Class="mt-2" OnClick="ClearFilters">
            @LocalizationSvc.GetString("ClearFiltersButton")
        </MudButton>
    }
</MudPaper>

<MudDataGrid T="Enrollment" Items="FilteredEnrollments" Dense="true" Hover="true" Loading="_loading">
    <Columns>
        <TemplateColumn Title="@LocalizationSvc.GetString("FullNameCol")">
            <CellTemplate>@(context.Item.Student?.FullName ?? "—")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("CompanyCol")">
            <CellTemplate>@(string.IsNullOrWhiteSpace(context.Item.CompanyName) ? LocalizationSvc.GetString("PrivatelyText") : context.Item.CompanyName)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("AttendanceCol")">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@AttendanceColor(context.Item.AttendanceStatus)">@AttendanceLabel(context.Item.AttendanceStatus)</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("DocumentsHeader")">
            <CellTemplate>@DocLabel(context.Item.DocumentsStatus)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("PaymentStatusLabel")">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@PaymentColor(context.Item.PaymentStatus)">@PaymentLabel(context.Item.PaymentStatus)</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("AmountPaidLabel")">
            <CellTemplate>@context.Item.AmountPaid.ToString("0.##") zł</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@LocalizationSvc.GetString("ActionCol")">
            <CellTemplate>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                           OnClick='@(() => Nav.NavigateTo("/students"))'>
                    @LocalizationSvc.GetString("OpenStudentCardAction")
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@LocalizationSvc.GetString("NoStudentsForDate")</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    [Parameter] public Guid TermId { get; set; }

    private CourseTerm? _term;
    private List<Enrollment> _enrollments = new();
    private bool _loading = true;

    private IReadOnlyCollection<string> _filterAttendance = new HashSet<string>();
    private IReadOnlyCollection<string> _filterPayment = new HashSet<string>();
    private string _filterCompany = string.Empty;

    private bool HasActiveFilters => _filterAttendance.Any() || _filterPayment.Any() || !string.IsNullOrWhiteSpace(_filterCompany);

    private IEnumerable<Enrollment> FilteredEnrollments => _enrollments.Where(e =>
        (!_filterAttendance.Any() || _filterAttendance.Contains(e.AttendanceStatus)) &&
        (!_filterPayment.Any() || _filterPayment.Contains(e.PaymentStatus)) &&
        (string.IsNullOrWhiteSpace(_filterCompany) || (e.CompanyName?.Contains(_filterCompany, StringComparison.OrdinalIgnoreCase) ?? false)));

    private void ClearFilters()
    {
        _filterAttendance = new HashSet<string>();
        _filterPayment = new HashSet<string>();
        _filterCompany = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        LocalizationSvc.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LocalizationSvc.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var allTerms = await CourseTermSvc.GetAllAsync();
            _term = allTerms.FirstOrDefault(t => t.Id == TermId);

            var allEnrollments = await EnrollSvc.GetAllAsync();
            _enrollments = allEnrollments.Where(e => e.CourseTermId == TermId).ToList();
        }
        catch { Snackbar.Add(LocalizationSvc.GetString("ErrorLoadingData"), Severity.Error); }
        finally { _loading = false; }
    }

    private void GoBack()
    {
        if (_term is not null) Nav.NavigateTo($"/courses/{_term.CourseId}/terms");
        else Nav.NavigateTo("/courses");
    }

    private static string AttendanceLabel(string status) => status switch
    {
        "waiting_arrival" => "Oczekuje na przyjazd",
        "arrived" => "Dojechał",
        "no_show" => "Nie dojechał",
        "late" => "Spóźniony",
        _ => status
    };

    private static Color AttendanceColor(string status) => status switch
    {
        "arrived" => Color.Success,
        "no_show" => Color.Error,
        "late" => Color.Warning,
        _ => Color.Default
    };

    private static string DocLabel(string status) => status switch
    {
        "not_checked" => "Nie sprawdzono",
        "missing" => "Brak",
        "partial" => "Częściowo",
        "received" => "Otrzymano",
        "not_required" => "Niewymagane",
        _ => status
    };

    private static string PaymentLabel(string status) => status switch
    {
        "unpaid" => "Nie zapłacono",
        "partial" => "Częściowo zapłacono",
        "paid" => "Zapłacono",
        "overpaid" => "Nadpłata",
        "not_required" => "Niewymagane",
        _ => status
    };

    private static Color PaymentColor(string status) => status switch
    {
        "unpaid" => Color.Error,
        "partial" => Color.Warning,
        "paid" => Color.Success,
        "overpaid" => Color.Info,
        _ => Color.Default
    };
}
