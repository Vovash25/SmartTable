@page "/students"
@using SmartTable.Client.Models
@inject IStudentService StudentSvc
@inject IEnrollmentService EnrollSvc
@inject IRegistrationService RegSvc
@inject IDialogService DialogSvc
@inject ISnackbar Snackbar
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc
@implements IDisposable

<PageTitle>@LocalizationSvc.GetString("StudentsPageTitle") — SmartTable</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">@LocalizationSvc.GetString("StudentsPageTitle")</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @LocalizationSvc.GetString("StudentsTotalCaption"): @_students.Count — @LocalizationSvc.GetString("NewStudentsAutoNote")
        </MudText>
    </div>
</div>

<MudTextField @bind-Value="_searchTerm"
              Placeholder="@LocalizationSvc.GetString("SearchStudents")"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined"
              Immediate="true"
              DebounceInterval="250"
              Class="mb-4"
              Style="max-width:480px;" />

<MudDataGrid T="Student"
             Items="FilteredStudents"
             SortMode="SortMode.Multiple"
             Hover="true"
             Striped="true"
             Dense="true"
             Loading="_loading">
    <Columns>
        <HierarchyColumn T="Student" />
        <PropertyColumn Property="x => x.FullName" Title="@LocalizationSvc.GetString("FullNameCol")" />
        <PropertyColumn Property="x => x.PkkNumber" Title="PKK" />

        <TemplateColumn Title="@LocalizationSvc.GetString("CoursesCol")">
            <CellTemplate>
                @{ var enrolls = GetEnrollmentsFor(context.Item); }
                @if (enrolls.Any())
                {
                    <MudStack Spacing="1">
                        @foreach (var e in enrolls)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@($"{e.Course?.CourseType} {e.Course?.Language}".Trim())</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@EnrollmentStatusColor(e.Status)">@EnrollmentStatusLabel(e.Status)</MudChip>
                            </MudStack>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@LocalizationSvc.GetString("NoActiveCourses")</MudText>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@LocalizationSvc.GetString("OverallStatusCol")">
            <CellTemplate>
                @{ var overall = GetOverallStatus(context.Item); }
                <MudChip T="string" Color="@overall.Color" Size="Size.Small">@overall.Label</MudChip>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@LocalizationSvc.GetString("AttendanceCol")">
            <CellTemplate>
                @{ var e = GetEnrollmentsFor(context.Item).FirstOrDefault(x => x.Status == "Active") ?? GetEnrollmentsFor(context.Item).FirstOrDefault(); }
                @if (e is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@AttendanceColor(e.AttendanceStatus)">@AttendanceLabel(e.AttendanceStatus)</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@LocalizationSvc.GetString("PaymentsCol")">
            <CellTemplate>
                @{
                    var enrolls = GetEnrollmentsFor(context.Item);
                    var due = enrolls.Sum(AmountDue);
                    var paid = enrolls.Sum(x => x.AmountPaid);
                }
                @if (!enrolls.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@PaymentSummaryColor(due, paid)">
                        @($"{paid:0.##} / {due:0.##} zł")
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@LocalizationSvc.GetString("ActionCol")" CellStyle="width:120px;">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@LocalizationSvc.GetString("EditBasicDataTooltip")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditDialog(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="@LocalizationSvc.GetString("DeleteStudentTooltip")">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteStudent(context.Item))" />
                    </MudTooltip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    @* KARTA STUDENTA — jedna karta na każdy zapisany kurs (Etap 3, sekcja 5.2–5.10) *@
    <ChildRowContent>
        @{ var studentEnrollments = GetEnrollmentsFor(context.Item); }
        @if (!studentEnrollments.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
                @LocalizationSvc.GetString("NoCourseAssignedInfo")
            </MudAlert>
        }
        else
        {
            @foreach (var enrollment in studentEnrollments)
            {
                <MudCard Elevation="0" Class="pa-4 my-2" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Class="mr-1 mb-1" />
                            @($"{enrollment.Course?.CourseType} {enrollment.Course?.Language}".Trim())
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="@EnrollmentStatusColor(enrollment.Status)">@EnrollmentStatusLabel(enrollment.Status)</MudChip>
                    </div>

                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

                        @* ── SEKCJA A + B: Obecność i Dokumenty ───────────────────────── *@
                        <MudTabPanel Text="@LocalizationSvc.GetString("AttendanceDocumentsTab")">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@LocalizationSvc.GetString("AttendanceHeader")</MudText>
                                    <MudSelect T="string" @bind-Value="enrollment.AttendanceStatus" Label="@LocalizationSvc.GetString("AttendanceStatusLabel")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("waiting_arrival")">@LocalizationSvc.GetString("ArrivalWaiting")</MudSelectItem>
                                        <MudSelectItem Value="@("arrived")">@LocalizationSvc.GetString("ArrivalArrived")</MudSelectItem>
                                        <MudSelectItem Value="@("no_show")">@LocalizationSvc.GetString("ArrivalNoShow")</MudSelectItem>
                                        <MudSelectItem Value="@("late")">@LocalizationSvc.GetString("ArrivalLate")</MudSelectItem>
                                    </MudSelect>
                                    <MudDatePicker @bind-Date="enrollment.ArrivalDate" Label="@LocalizationSvc.GetString("ArrivalDateLabel")" Variant="Variant.Outlined" Dense="true" Class="mt-3" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@LocalizationSvc.GetString("DocumentsHeader")</MudText>
                                    <MudSelect T="string" @bind-Value="enrollment.DocumentsStatus" Label="@LocalizationSvc.GetString("DocumentsStatusLabel")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("not_checked")">@LocalizationSvc.GetString("DocNotChecked")</MudSelectItem>
                                        <MudSelectItem Value="@("missing")">@LocalizationSvc.GetString("DocMissing")</MudSelectItem>
                                        <MudSelectItem Value="@("partial")">@LocalizationSvc.GetString("DocPartial")</MudSelectItem>
                                        <MudSelectItem Value="@("received")">@LocalizationSvc.GetString("DocReceived")</MudSelectItem>
                                        <MudSelectItem Value="@("not_required")">@LocalizationSvc.GetString("DocNotRequired")</MudSelectItem>
                                    </MudSelect>
                                    <MudStack Spacing="4" Class="mt-3">
                                        <MudCheckBox T="bool" @bind-Value="enrollment.DocPassport" Label="@LocalizationSvc.GetString("PassportLabel")" Dense="true" />
                                        <MudCheckBox T="bool" @bind-Value="enrollment.DocDrivingLicense" Label="@LocalizationSvc.GetString("DrivingLicenseLabel")" Dense="true" />
                                        <MudCheckBox T="bool" @bind-Value="enrollment.DocPkk" Label="@LocalizationSvc.GetString("PkkPkzLabel")" Dense="true" />
                                        <MudCheckBox T="bool" @bind-Value="enrollment.DocMedical" Label="@LocalizationSvc.GetString("MedicalExamShortLabel")" Dense="true" />
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        @* ── SEKCJA C: Płatności ──────────────────────────────────────── *@
                        <MudTabPanel Text="@LocalizationSvc.GetString("PaymentsTab")">
                            <MudGrid>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="string" @bind-Value="enrollment.PaymentStatus" Label="@LocalizationSvc.GetString("PaymentStatusLabel")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("unpaid")">@LocalizationSvc.GetString("PayUnpaid")</MudSelectItem>
                                        <MudSelectItem Value="@("partial")">@LocalizationSvc.GetString("PayPartial")</MudSelectItem>
                                        <MudSelectItem Value="@("paid")">@LocalizationSvc.GetString("PayPaid")</MudSelectItem>
                                        <MudSelectItem Value="@("overpaid")">@LocalizationSvc.GetString("PayOverpaid")</MudSelectItem>
                                        <MudSelectItem Value="@("not_required")">@LocalizationSvc.GetString("PayNotRequired")</MudSelectItem>
                                    </MudSelect>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                                               StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                               OnClick="@(() => enrollment.PaymentStatus = SuggestPaymentStatus(enrollment))">
                                        @LocalizationSvc.GetString("SuggestedLabel"): @PaymentLabel(SuggestPaymentStatus(enrollment))
                                    </MudButton>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="string" @bind-Value="enrollment.PaymentMethod" Label="@LocalizationSvc.GetString("PaymentMethod")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("cash")">@LocalizationSvc.GetString("PayCash")</MudSelectItem>
                                        <MudSelectItem Value="@("bank_transfer")">@LocalizationSvc.GetString("PayBankTransfer")</MudSelectItem>
                                        <MudSelectItem Value="@("company")">@LocalizationSvc.GetString("PayCompany")</MudSelectItem>
                                        <MudSelectItem Value="@("mixed")">@LocalizationSvc.GetString("PayMixed")</MudSelectItem>
                                        <MudSelectItem Value="@("other")">@LocalizationSvc.GetString("PayOther")</MudSelectItem>
                                    </MudSelect>
                                    <MudCheckBox T="bool" @bind-Value="enrollment.HasInvoice" Label="@LocalizationSvc.GetString("InvoiceLabel")" Dense="true" Class="mt-2" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudNumericField T="decimal" @bind-Value="enrollment.CoursePrice" Label="@LocalizationSvc.GetString("CoursePriceLabel")" Variant="Variant.Outlined" Dense="true" Format="0.##" />
                                    <MudNumericField T="decimal" @bind-Value="enrollment.AmountPaid" Label="@LocalizationSvc.GetString("AmountPaidLabel")" Variant="Variant.Outlined" Dense="true" Class="mt-3" Format="0.##" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudAlert Severity="@(Remaining(enrollment) > 0 ? Severity.Warning : Remaining(enrollment) < 0 ? Severity.Info : Severity.Success)" Dense="true">
                                        @(Remaining(enrollment) > 0
                                            ? $"{LocalizationSvc.GetString("RemainingLabel")}: {Remaining(enrollment):0.##} zł"
                                            : Remaining(enrollment) < 0
                                                ? $"{LocalizationSvc.GetString("OverpaidLabel")}: {-Remaining(enrollment):0.##} zł"
                                                : LocalizationSvc.GetString("FullyPaidLabel"))
                                    </MudAlert>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                        @LocalizationSvc.GetString("TotalDueWithServicesLabel"): @AmountDue(enrollment).ToString("0.##") zł
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" @bind-Value="enrollment.PaymentNotes" Label="@LocalizationSvc.GetString("PaymentNotesLabel")" Variant="Variant.Outlined" Lines="2" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        @* ── SEKCJA D + E: Usługi dodatkowe i Hotel ───────────────────── *@
                        <MudTabPanel Text="@LocalizationSvc.GetString("ServicesHotelTab")">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@LocalizationSvc.GetString("AdditionalServicesHeader")</MudText>
                                    <MudStack Spacing="4">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
                                            <MudCheckBox T="bool" @bind-Value="enrollment.SvcMedical" Label="@LocalizationSvc.GetString("MedicalExamCheckboxLabel")" Dense="true" />
                                            <MudNumericField T="decimal?" @bind-Value="enrollment.MedicalExamPrice" Variant="Variant.Outlined" Dense="true" Format="0.##" Adornment="Adornment.End" AdornmentText="zł" Style="max-width:140px;" />
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
                                            <MudCheckBox T="bool" @bind-Value="enrollment.SvcPsychological" Label="@LocalizationSvc.GetString("PsychExamCheckboxLabel")" Dense="true" />
                                            <MudNumericField T="decimal?" @bind-Value="enrollment.PsychologicalExamPrice" Variant="Variant.Outlined" Dense="true" Format="0.##" Adornment="Adornment.End" AdornmentText="zł" Style="max-width:140px;" />
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
                                            <MudCheckBox T="bool" @bind-Value="enrollment.SvcTranslation" Label="@LocalizationSvc.GetString("TranslationCheckboxLabel")" Dense="true" />
                                            <MudNumericField T="decimal?" @bind-Value="enrollment.TranslationPrice" Variant="Variant.Outlined" Dense="true" Format="0.##" Adornment="Adornment.End" AdornmentText="zł" Style="max-width:140px;" />
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
                                            <MudCheckBox T="bool" @bind-Value="enrollment.SvcPowerOfAttorney" Label="@LocalizationSvc.GetString("PowerOfAttorneyCheckboxLabel")" Dense="true" />
                                            <MudNumericField T="decimal?" @bind-Value="enrollment.PowerOfAttorneyPrice" Variant="Variant.Outlined" Dense="true" Format="0.##" Adornment="Adornment.End" AdornmentText="zł" Style="max-width:140px;" />
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
                                            <MudText Typo="Typo.body2" Style="min-width:170px;">@LocalizationSvc.GetString("PkkPkzFeeLabel")</MudText>
                                            <MudNumericField T="decimal?" @bind-Value="enrollment.PkzPrice" Variant="Variant.Outlined" Dense="true" Format="0.##" Adornment="Adornment.End" AdornmentText="zł" Style="max-width:140px;" />
                                        </MudStack>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@LocalizationSvc.GetString("HotelHeader")</MudText>
                                    <MudCheckBox T="bool" @bind-Value="enrollment.NeedsHotel" Label="@LocalizationSvc.GetString("NeedsHotelLabel")" Dense="true" Class="mb-2" />
                                    <MudSelect T="string" @bind-Value="enrollment.HotelStatus" Label="@LocalizationSvc.GetString("HotelStatusLabel")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("not_required")">@LocalizationSvc.GetString("HotelNotRequired")</MudSelectItem>
                                        <MudSelectItem Value="@("needed")">@LocalizationSvc.GetString("HotelNeeded")</MudSelectItem>
                                        <MudSelectItem Value="@("reserved")">@LocalizationSvc.GetString("HotelReserved")</MudSelectItem>
                                        <MudSelectItem Value="@("checked_in")">@LocalizationSvc.GetString("HotelCheckedIn")</MudSelectItem>
                                        <MudSelectItem Value="@("cancelled")">@LocalizationSvc.GetString("HotelCancelled")</MudSelectItem>
                                    </MudSelect>
                                    <div class="d-flex gap-2 mt-3">
                                        <MudDatePicker @bind-Date="enrollment.HotelFrom" Label="@LocalizationSvc.GetString("HotelFromLabel")" Variant="Variant.Outlined" Dense="true" />
                                        <MudDatePicker @bind-Date="enrollment.HotelTo" Label="@LocalizationSvc.GetString("HotelToLabel")" Variant="Variant.Outlined" Dense="true" />
                                    </div>
                                    <MudTextField T="string" @bind-Value="enrollment.HotelStayRange" Label="@LocalizationSvc.GetString("HotelStayRangeLabel")" Variant="Variant.Outlined" Dense="true" Class="mt-3" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        @* ── SEKCJA F + G: Status końcowy i uwagi biura ───────────────── *@
                        <MudTabPanel Text="@LocalizationSvc.GetString("FinalStatusTab")">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="enrollment.Status" Label="@LocalizationSvc.GetString("CourseStatusLabel")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@("Active")">@LocalizationSvc.GetString("CourseInProgress")</MudSelectItem>
                                        <MudSelectItem Value="@("Finished")">@LocalizationSvc.GetString("StatusFinished")</MudSelectItem>
                                        <MudSelectItem Value="@("Dropped")">@LocalizationSvc.GetString("StatusDropped")</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="enrollment.Notes" Label="@LocalizationSvc.GetString("OfficeNotesLabel")" Variant="Variant.Outlined" Lines="2" Placeholder="@LocalizationSvc.GetString("OfficeNotesPlaceholder")" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                    </MudTabs>

                    <div class="d-flex justify-end mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@(() => SaveEnrollment(enrollment))">
                            @LocalizationSvc.GetString("SaveDataButton")
                        </MudButton>
                    </div>
                </MudCard>
            }
        }
    </ChildRowContent>

    <NoRecordsContent>
        <MudText Color="Color.Secondary">@LocalizationSvc.GetString("NoStudentsInDb")</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Student> _students = new();
    private List<Enrollment> _enrollments = new();
    private List<CandidateRegistration> _candidates = new();
    private string _searchTerm = string.Empty;
    private bool _loading = true;

    private IEnumerable<Student> FilteredStudents => _students.Where(s =>
        string.IsNullOrWhiteSpace(_searchTerm) ||
        (s.FullName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (s.PkkNumber?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (s.Citizenship?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
        GetEnrollmentsFor(s).Any(e =>
            (e.Course?.CourseType?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (e.Course?.Language?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)));

    private List<Enrollment> GetEnrollmentsFor(Student student) =>
        _enrollments.Where(e => e.StudentId == student.Id).ToList();

    // ── Status ogólny (zsynchronizowany z logiką strony Kandydaci) ──────────────
    private (Color Color, string Label) GetOverallStatus(Student student)
    {
        var enrolls = GetEnrollmentsFor(student);
        var candidate = _candidates.FirstOrDefault(c => string.Equals(c.FullName, student.FullName, StringComparison.OrdinalIgnoreCase));

        if (candidate?.Status == "canceled")
            return (Color.Error, LocalizationSvc.GetString("StatusCancelled"));

        var hasActive = enrolls.Any(e => e.Status == "Active");
        var hasFinished = enrolls.Any(e => e.Status == "Finished");
        var hasDropped = enrolls.Any(e => e.Status == "Dropped");

        if (hasActive || !enrolls.Any())
            return (Color.Success, LocalizationSvc.GetString("StatusRegistered"));
        if (hasFinished)
            return (Color.Info, LocalizationSvc.GetString("StatusFinished"));
        if (hasDropped)
            return (Color.Dark, LocalizationSvc.GetString("StatusDropped"));

        return (Color.Success, LocalizationSvc.GetString("StatusRegistered"));
    }

    private string EnrollmentStatusLabel(string status) => status switch
    {
        "Active" => LocalizationSvc.GetString("CourseInProgress"),
        "Finished" => LocalizationSvc.GetString("StatusFinished"),
        "Dropped" => LocalizationSvc.GetString("StatusDropped"),
        _ => status
    };

    private static Color EnrollmentStatusColor(string status) => status switch
    {
        "Active" => Color.Warning,
        "Finished" => Color.Info,
        "Dropped" => Color.Dark,
        _ => Color.Default
    };

    private string AttendanceLabel(string status) => status switch
    {
        "waiting_arrival" => LocalizationSvc.GetString("ArrivalWaiting"),
        "arrived" => LocalizationSvc.GetString("ArrivalArrived"),
        "no_show" => LocalizationSvc.GetString("ArrivalNoShow"),
        "late" => LocalizationSvc.GetString("ArrivalLate"),
        _ => status
    };

    private static Color AttendanceColor(string status) => status switch
    {
        "waiting_arrival" => Color.Default,
        "arrived" => Color.Success,
        "no_show" => Color.Error,
        "late" => Color.Warning,
        _ => Color.Default
    };

    private string PaymentLabel(string status) => status switch
    {
        "unpaid" => LocalizationSvc.GetString("PayUnpaid"),
        "partial" => LocalizationSvc.GetString("PayPartial"),
        "paid" => LocalizationSvc.GetString("PayPaid"),
        "overpaid" => LocalizationSvc.GetString("PayOverpaid"),
        "not_required" => LocalizationSvc.GetString("PayNotRequired"),
        _ => status
    };

    private static Color PaymentSummaryColor(decimal due, decimal paid)
    {
        if (due <= 0) return Color.Default;
        if (paid <= 0) return Color.Error;
        if (paid < due) return Color.Warning;
        if (paid == due) return Color.Success;
        return Color.Info;
    }

    // Kwota do zapłaty = cena kursu + zaznaczone usługi dodatkowe + opłata PKK/PKZ
    private static decimal AmountDue(Enrollment e) =>
        e.CoursePrice
        + (e.SvcMedical ? (e.MedicalExamPrice ?? 0) : 0)
        + (e.SvcPsychological ? (e.PsychologicalExamPrice ?? 0) : 0)
        + (e.SvcTranslation ? (e.TranslationPrice ?? 0) : 0)
        + (e.SvcPowerOfAttorney ? (e.PowerOfAttorneyPrice ?? 0) : 0)
        + (e.PkzPrice ?? 0);

    private static decimal Remaining(Enrollment e) => AmountDue(e) - e.AmountPaid;

    private static string SuggestPaymentStatus(Enrollment e)
    {
        var due = AmountDue(e);
        if (due <= 0) return "not_required";
        if (e.AmountPaid <= 0) return "unpaid";
        if (e.AmountPaid < due) return "partial";
        if (e.AmountPaid == due) return "paid";
        return "overpaid";
    }

    protected override async Task OnInitializedAsync()
    {
        LocalizationSvc.OnLanguageChanged += StateHasChanged;
        await LoadStudentsAsync();
    }

    public void Dispose()
    {
        LocalizationSvc.OnLanguageChanged -= StateHasChanged;
    }

    private async Task LoadStudentsAsync()
    {
        _loading = true;
        try
        {
            _students = await StudentSvc.GetAllAsync();
            _enrollments = await EnrollSvc.GetAllAsync();
            _candidates = await RegSvc.GetAllAsync();
        }
        catch { Snackbar.Add(LocalizationSvc.GetString("ErrorLoadingData"), Severity.Error); }
        finally { _loading = false; }
    }

    private async Task SaveEnrollment(Enrollment enrollment)
    {
        // Nie wysyłamy powiązanych obiektów nawigacyjnych (jak w EnrollmentsController)
        var student = enrollment.Student;
        var course = enrollment.Course;
        enrollment.Student = null;
        enrollment.Course = null;

        var success = await EnrollSvc.UpdateAsync(enrollment);

        enrollment.Student = student;
        enrollment.Course = course;

        if (success)
            Snackbar.Add(LocalizationSvc.GetString("EnrollmentSaved"), Severity.Success);
        else
            Snackbar.Add(LocalizationSvc.GetString("EnrollmentSaveError"), Severity.Error);
    }

    // Studenci pojawiają się tu wyłącznie poprzez przypisanie kandydata do kursu
    // na stronie Kandydaci — dlatego jest tylko edycja danych podstawowych, bez dodawania.
    private async Task OpenEditDialog(Student s)
    {
        var model = new Student
        {
            Id = s.Id,
            FullName = s.FullName,
            Citizenship = s.Citizenship,
            PkkNumber = s.PkkNumber,
            DateOfBirth = s.DateOfBirth,
            CreatedAt = s.CreatedAt
        };

        var parameters = new DialogParameters { ["Model"] = model, ["IsNew"] = false };
        var dialog = await DialogSvc.ShowAsync<StudentDialog>(
            LocalizationSvc.GetString("EditDataTitle"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (!result.Canceled && result.Data is Student saved)
        {
            var success = await StudentSvc.UpdateAsync(saved);
            if (success)
            {
                Snackbar.Add(LocalizationSvc.GetString("SavedSuccessfully"), Severity.Success);
                await LoadStudentsAsync();
            }
            else Snackbar.Add(LocalizationSvc.GetString("SaveError"), Severity.Error);
        }
    }

    private async Task DeleteStudent(Student student)
    {
        var confirmed = await DialogSvc.ShowMessageBoxAsync(LocalizationSvc.GetString("Confirmation"), $"{LocalizationSvc.GetString("DeleteStudentConfirmMessage")} «{student.FullName}»?", yesText: LocalizationSvc.GetString("Yes"), cancelText: LocalizationSvc.GetString("Cancel"));
        if (confirmed == true)
        {
            var ok = await StudentSvc.DeleteAsync(student.Id);
            if (ok)
            {
                Snackbar.Add(LocalizationSvc.GetString("Deleted"), Severity.Success);
                await LoadStudentsAsync();
            }
            else Snackbar.Add(LocalizationSvc.GetString("DeleteError"), Severity.Error);
        }
    }
}
