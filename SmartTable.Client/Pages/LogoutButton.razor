@* Вставте <LogoutButton /> у ваш NavMenu.razor, наприклад під блоком "Language:" *@
@using SmartTable.Client.Services
@inject AuthService AuthSvc
@inject NavigationManager Nav
@inject LocalizationService LocalizationSvc

<AuthorizeView>
    <Authorized>
        <MudDivider Class="my-3" />
        <div class="px-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                @LocalizationSvc.GetString("LoggedInAs"): @context.User.Identity?.Name
            </MudText>
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Logout"
                       FullWidth="true"
                       OnClick="Logout">
                @LocalizationSvc.GetString("LogoutButtonText")
            </MudButton>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await AuthSvc.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
