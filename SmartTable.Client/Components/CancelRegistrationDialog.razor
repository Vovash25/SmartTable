@using SmartTable.Client.Models
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @LocalizationSvc.GetString("CancelReasonPrompt"): <strong>@Model.FullName</strong>
        </MudText>
        
        <MudTextField @bind-Value="_cancelReason" 
                      Label="@LocalizationSvc.GetString("CancelReasonLabel")" 
                      Variant="Variant.Outlined" 
                      Lines="3" 
                      Required="true" 
                      RequiredError="@LocalizationSvc.GetString("CancelReasonRequired")" 
                      Placeholder="@LocalizationSvc.GetString("CancelReasonPlaceholder")" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@LocalizationSvc.GetString("GoBack")</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(_cancelReason)">
            @LocalizationSvc.GetString("ConfirmCancellation")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CandidateRegistration Model { get; set; } = new();

    private string _cancelReason = string.Empty;

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_cancelReason))
        {
            MudDialog.Close(DialogResult.Ok(_cancelReason));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
