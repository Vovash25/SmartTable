@inject ISnackbar Snackbar
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="Model.FullName"
                              Label="@LocalizationSvc.GetString("FullNameLabel")"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@LocalizationSvc.GetString("RequiredField")"
                              Immediate="true" />

                <MudDatePicker @bind-Date="_dateOfBirth"
                               Label="@LocalizationSvc.GetString("DateOfBirth")"
                               Variant="Variant.Outlined"
                               DateFormat="dd.MM.yyyy"
                               MaxDate="DateTime.Today" />

                <MudTextField @bind-Value="Model.Citizenship"
                              Label="@LocalizationSvc.GetString("Citizenship")"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@LocalizationSvc.GetString("RequiredField")" />

                <MudTextField @bind-Value="Model.PkkNumber"
                              Label="@LocalizationSvc.GetString("PkkNumber")"
                              Variant="Variant.Outlined"
                              Placeholder="@LocalizationSvc.GetString("OptionalPlaceholder")" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Text">
            @LocalizationSvc.GetString("Cancel")
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="!_isValid">
            @(IsNew ? LocalizationSvc.GetString("Add") : LocalizationSvc.GetString("Save"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Student Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _isValid;

    private DateTime? _dateOfBirth
    {
        get => Model.DateOfBirth == default ? null : Model.DateOfBirth;
        set => Model.DateOfBirth = value ?? DateTime.Today;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (_isValid)
            MudDialog.Close(DialogResult.Ok(Model));
    }
}
