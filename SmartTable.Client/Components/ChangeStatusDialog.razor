@using SmartTable.Client.Models
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @LocalizationSvc.GetString("CandidateLabel"): <strong>@Model.FullName</strong><br/>
            @LocalizationSvc.GetString("ActionLabel"): <strong>@ActionName</strong>
        </MudText>
        
        @if (TargetStatus == "finished" || TargetStatus == "dropped" || TargetStatus == "remove_course")
        {
            <MudSelect T="Guid?" @bind-Value="_selectedEnrollmentId"
                       Label="@LocalizationSvc.GetString("SelectCourseLabel")"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="@LocalizationSvc.GetString("SelectCourseRequired")"
                       Class="mb-4">
                @foreach (var enrollment in ActiveEnrollments)
                {
                    <MudSelectItem T="Guid?" Value="@enrollment.Id">
                        @($"{enrollment.Course?.CourseType} {enrollment.Course?.Language}".Trim())
                    </MudSelectItem>
                }
            </MudSelect>

            @if (!ActiveEnrollments.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
                    @LocalizationSvc.GetString("NoActiveCoursesWarning")
                </MudAlert>
            }
        }

        @if (TargetStatus != "remove_course")
        {
            <MudTextField @bind-Value="_notes" 
                          Label="@NotesLabel" 
                          Variant="Variant.Outlined" 
                          Lines="3" 
                          Required="@IsReasonRequired" 
                          RequiredError="@LocalizationSvc.GetString("ReasonRequiredError")" 
                          Placeholder="@PlaceholderText" />
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-4">
                @LocalizationSvc.GetString("RemoveCourseWarning")
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@LocalizationSvc.GetString("GoBack")</MudButton>
        <MudButton Color="@ButtonColor" Variant="Variant.Filled" OnClick="Submit" 
                   Disabled="@(IsInvalid)">
            @LocalizationSvc.GetString("Confirm")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CandidateRegistration Model { get; set; } = new();
    [Parameter] public string TargetStatus { get; set; } = string.Empty;
    [Parameter] public List<Enrollment> ActiveEnrollments { get; set; } = new();

    private string _notes = string.Empty;
    private Guid? _selectedEnrollmentId;

    private bool IsReasonRequired => TargetStatus == "canceled" || TargetStatus == "dropped";
    
    private bool IsInvalid => 
        (IsReasonRequired && string.IsNullOrWhiteSpace(_notes)) || 
        ((TargetStatus == "finished" || TargetStatus == "dropped" || TargetStatus == "remove_course") && _selectedEnrollmentId is null);

    private string ActionName => TargetStatus switch {
        "canceled" => LocalizationSvc.GetString("ActionCancelling"),
        "dropped" => LocalizationSvc.GetString("ActionDropping"),
        "finished" => LocalizationSvc.GetString("ActionFinishing"),
        "remove_course" => LocalizationSvc.GetString("ActionRemoving"),
        _ => LocalizationSvc.GetString("ActionGeneric")
    };

    private string NotesLabel => TargetStatus == "finished" ? LocalizationSvc.GetString("NotesOptional") : LocalizationSvc.GetString("ReasonRequiredLabel");
    private string PlaceholderText => TargetStatus == "finished" ? LocalizationSvc.GetString("PlaceholderFinished") : LocalizationSvc.GetString("PlaceholderReason");
    private Color ButtonColor => TargetStatus == "finished" ? Color.Info : Color.Error;

    protected override void OnInitialized()
    {
        if (ActiveEnrollments.Count == 1)
        {
            _selectedEnrollmentId = ActiveEnrollments.First().Id;
        }
    }

    private void Submit()
    {
        if (IsInvalid) return;

        var result = new StatusChangeResult 
        { 
            Notes = _notes, 
            EnrollmentId = _selectedEnrollmentId
        };
        
        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();

    public class StatusChangeResult
    {
        public string Notes { get; set; } = string.Empty;
        public Guid? EnrollmentId { get; set; }
    }
}
