@using SmartTable.Client.Models
@inject ICourseTermService CourseTermSvc
@inject SmartTable.Client.Services.LocalizationService LocalizationSvc

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @LocalizationSvc.GetString("ChooseCoursesFor"): <strong>@Candidate.FullName</strong>
        </MudText>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var course in Courses)
                {
                    var availableTerms = _termsByCourse.TryGetValue(course.Id, out var list)
                        ? list.Where(t => t.Status is not ("cancelled" or "finished")).OrderBy(t => t.StartDate).ToList()
                        : new List<CourseTerm>();

                    <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@course.CourseType @course.Language</MudText>

                        @if (!availableTerms.Any())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @LocalizationSvc.GetString("NoAvailableTermsForCourse")
                            </MudText>
                        }
                        else
                        {
                            @foreach (var term in availableTerms)
                            {
                                var label = $"{term.StartDate:dd.MM.yyyy} – {term.EndDate:dd.MM.yyyy}" +
                                            (string.IsNullOrWhiteSpace(term.Trainer) ? "" : $" ({term.Trainer})");

                                <MudCheckBox T="bool"
                                             Value="@_selectedTermIds.Contains(term.Id)"
                                             ValueChanged="@((bool v) => ToggleTerm(term.Id, v))"
                                             Label="@label"
                                             Dense="true" />
                            }
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@LocalizationSvc.GetString("Cancel")</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Submit" Disabled="!_selectedTermIds.Any()">
            @LocalizationSvc.GetString("AssignToCourses")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CandidateRegistration Candidate { get; set; } = new();
    [Parameter] public List<Course> Courses { get; set; } = new();

    private readonly HashSet<Guid> _selectedTermIds = new();
    private Dictionary<Guid, List<CourseTerm>> _termsByCourse = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allTerms = await CourseTermSvc.GetAllAsync();
            _termsByCourse = allTerms.GroupBy(t => t.CourseId).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch
        {
            _termsByCourse = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleTerm(Guid termId, bool selected)
    {
        if (selected) _selectedTermIds.Add(termId);
        else _selectedTermIds.Remove(termId);
    }

    private void Submit()
    {
        if (!_selectedTermIds.Any()) return;

        var result = _selectedTermIds.Select(termId => new CourseAssignmentItem(termId)).ToList();
        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();
}
