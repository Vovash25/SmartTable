@using CountryData.Standard

<MudDialog Style="min-height:70vh; min-width: 600px;">
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">

            <MudText Typo="Typo.h6" Class="mt-2 mb-4" Color="Color.Primary">Dane kandydata</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.FullName" Label="Imię i nazwisko" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="4">
                    <MudSelect T="string"
                               @bind-Value="Model.CountryCode"
                               Label="Kod kraju"
                               Required="true"
                               Variant="Variant.Outlined">

                        <!-- Найпопулярніші -->
                        <MudSelectItem Value="@("+370")"><span class="fi fi-lt" style="margin-right:8px;"></span>+370 (LT)</MudSelectItem>
                        <MudSelectItem Value="@("+48")"><span class="fi fi-pl" style="margin-right:8px;"></span>+48 (PL)</MudSelectItem>
                        <MudSelectItem Value="@("+380")"><span class="fi fi-ua" style="margin-right:8px;"></span>+380 (UA)</MudSelectItem>
                        <MudSelectItem Value="@("+420")"><span class="fi fi-cz" style="margin-right:8px;"></span>+420 (CZ)</MudSelectItem>

                        <MudDivider />

                        @foreach (var country in Countries
                             .Where(c => !string.IsNullOrEmpty(c.PhoneCode))
                             .OrderBy(c => c.CountryName))
                        {
                            @if (country.PhoneCode is not ("+370" or "+48" or "+380" or "+420"))
                            {
                                <MudSelectItem Value="@country.PhoneCode">
                                    <span class="fi fi-@country.CountryShortCode.ToLower()" style="margin-right:8px;"></span>@($"{country.PhoneCode} ({country.CountryShortCode})")
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="8">
                    <MudTextField @bind-Value="Model.NationalNumber" Label="Numer telefonu" Required="true" Variant="Variant.Outlined"
                                  HelperText="Format: 500 111 222 (spacje zostaną usunięte technicznie)" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="Model.PreferredContactLanguage" Label="Język kontaktu" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("PL")"><span class="fi fi-pl" style="margin-right:8px;"></span>PL</MudSelectItem>
                        <MudSelectItem Value="@("RUS")"><span class="fi fi-ru" style="margin-right:8px;"></span>RUS</MudSelectItem>
                        <MudSelectItem Value="@("ENG")"><span class="fi fi-gb" style="margin-right:8px;"></span>ENG</MudSelectItem>
                        <MudSelectItem Value="@("UKR")"><span class="fi fi-ua" style="margin-right:8px;"></span>UKR</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="Model.RegistrationSource" Label="Źródło zgłoszenia" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Telefon")">Telefon</MudSelectItem>
                        <MudSelectItem Value="@("WhatsApp")">WhatsApp</MudSelectItem>
                        <MudSelectItem Value="@("Firma")">Firma</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Kontakt</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="Model.PrimaryContactMethod" Label="Główny sposób kontaktu" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("phone_call")">Telefon</MudSelectItem>
                        <MudSelectItem Value="@("whatsapp")">WhatsApp</MudSelectItem>
                        <MudSelectItem Value="@("viber")">Viber</MudSelectItem>
                        <MudSelectItem Value="@("telegram")">Telegram</MudSelectItem>
                        <MudSelectItem Value="@("messenger")">Messenger</MudSelectItem>
                        <MudSelectItem Value="@("sms")">SMS</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.ContactNotes" Label="Uwagi do kontaktu" Lines="2" Variant="Variant.Outlined"
                                  Placeholder="Np. Nie dzwonić po 18:00" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Kurs i termin (Preferowany przez klienta)</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect @bind-Value="Model.CourseType" Label="Typ kursu" Variant="Variant.Outlined">
                        @* Ваші існуючі курси *@
                        <MudSelectItem Value="@("KWP")">KWP</MudSelectItem>
                        <MudSelectItem Value="@("SO")">SO</MudSelectItem>
                        <MudSelectItem Value="@("ADR")">ADR</MudSelectItem>
                        
                        @* НОВА ОПЦІЯ ДЛЯ КОМЕНТАРІВ *@
                        <MudSelectItem Value="@("Info")">Info (Tylko notatka)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="Model.PreferredCourseDate" Label="Preferowany termin kursu" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="Model.PlannedArrivalDate" Label="Planowana data przyjazdu" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.DateNotes" Label="Uwagi do terminu" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Firma</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudRadioGroup T="string" @bind-Value="Model.PayerType" Required="true">
                        <MudRadio Value="@("private_person")" Color="Color.Primary">Osoba prywatna</MudRadio>
                        <MudRadio Value="@("company")" Color="Color.Primary">Firma</MudRadio>
                        <MudRadio Value="@("unknown")" Color="Color.Default">Nie wiadomo</MudRadio>
                    </MudRadioGroup>
                </MudItem>
                @if (Model.PayerType == "company")
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.CompanyName" Label="Firma (Nazwa)" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Hotel</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudRadioGroup T="string" @bind-Value="Model.NeedsHotel" Required="true">
                        <MudRadio Value="@("yes")" Color="Color.Primary">Tak</MudRadio>
                        <MudRadio Value="@("no")" Color="Color.Primary">Nie</MudRadio>
                        <MudRadio Value="@("unknown")" Color="Color.Default">Nie wiadomo</MudRadio>
                    </MudRadioGroup>
                </MudItem>
                @if (Model.NeedsHotel == "yes")
                {
                    <MudItem xs="6">
                        <MudDatePicker @bind-Date="Model.HotelFrom" Label="Hotel od" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudDatePicker @bind-Date="Model.HotelTo" Label="Hotel do" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
                    </MudItem>
                }
                @if (Model.NeedsHotel == "yes" || Model.NeedsHotel == "unknown")
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.HotelNotes" Label="Uwagi do hotelu" Lines="2" Variant="Variant.Outlined" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Status i uwagi</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Model.Status" Label="Status rejestracji" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("new")">Nowe zgłoszenie</MudSelectItem>
                        <MudSelectItem Value="@("contacted")">Skontaktowano się</MudSelectItem>
                        <MudSelectItem Value="@("waiting_confirmation")">Oczekuje potwierdzenia</MudSelectItem>
                        <MudSelectItem Value="@("confirmed")">Potwierdzono</MudSelectItem>
                        <MudSelectItem Value="@("assigned_to_course")">Przypisano do kursu</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.RegistrationNotes" Label="Uwagi do rejestracji" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Text">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="!_isValid">
            @(IsNew ? "Zapisz" : "Aktualizuj")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CandidateRegistration Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private readonly List<Country> Countries = new CountryHelper().GetCountryData().ToList();

    private MudForm _form = null!;
    private bool _isValid;
    private string? _selectedCourseVariant;

    protected override void OnInitialized()
    {
        // Якщо це редагування, відновлюємо CourseVariantCode для дропдауна
        if (!string.IsNullOrEmpty(Model.CourseType) && !string.IsNullOrEmpty(Model.CourseLanguage))
        {
            _selectedCourseVariant = $"{Model.CourseType}_{Model.CourseLanguage}";
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_isValid)
        {
            if (!string.IsNullOrEmpty(Model.NationalNumber))
            {
                var cleanNumber = new string(Model.NationalNumber.Where(char.IsDigit).ToArray());
                Model.PhoneE164 = $"{Model.CountryCode}{cleanNumber}";
            }

            if (!string.IsNullOrEmpty(_selectedCourseVariant))
            {
                var parts = _selectedCourseVariant.Split('_');
                if (parts.Length == 2)
                {
                    Model.CourseType = parts[0];
                    Model.CourseLanguage = parts[1];
                    Model.CourseVariantCode = _selectedCourseVariant;
                }
            }

            MudDialog.Close(DialogResult.Ok(Model));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
